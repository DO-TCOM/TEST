const _avatarCache = {};
function getAvatarForUser(userId) {
    if (!_avatarCache[userId]) {
        _avatarCache[userId] = AVATARS[Math.floor(Math.random() * AVATARS.length)];
    }
    return _avatarCache[userId];
}

// Avatar local persistant dans localStorage
let _localAvatar = null;
function getLocalAvatar() {
    if (_localAvatar) return _localAvatar;
    const saved = localStorage.getItem('localAvatarIndex');
    const idx = saved !== null ? parseInt(saved) : Math.floor(Math.random() * AVATARS.length);
    if (saved === null) localStorage.setItem('localAvatarIndex', idx);
    _localAvatar = AVATARS[idx];
    return _localAvatar;
}


const socket = io();
window.socket = socket;

// Note: socket intentionally not exposed on window
const roomId = window.location.pathname.split('/').pop() || 'friends';

// ── Lecteur YouTube (room "general" uniquement, max 5 en file) ─────────────
let ytbPlayer = null;
let ytbApiReady = false;
let ytbPlayerReady = false;
let ytbCurrentQueue = [];
let ytbCurrentVideoId = null;

if (roomId === 'general') {
    const ytbTag = document.createElement('script');
    ytbTag.src = 'https://www.youtube.com/iframe_api';
    document.head.appendChild(ytbTag);

    const YTB_TXT = {
        FR: { title: '📺 File d\'attente', instr: 'Tape !ytb <lien> dans le chat pour ajouter une vidéo (max 5)', empty: 'File vide — sois le premier à ajouter une vidéo !', nowPlaying: '▶ En cours', skip: 'Passer', minimize: 'Réduire', expand: 'Vidéo' },
        EN: { title: '📺 Queue', instr: 'Type !ytb <link> in chat to add a video (max 5)', empty: 'Queue empty — be the first to add a video!', nowPlaying: '▶ Now playing', skip: 'Skip', minimize: 'Minimize', expand: 'Video' },
    };
    function ytbLang() { return (localStorage.getItem('roomLang') || 'FR') === 'EN' ? YTB_TXT.EN : YTB_TXT.FR; }

    // Position sauvegardée (ou défaut : gauche, centré verticalement)
    const savedPos = JSON.parse(localStorage.getItem('ytbPos') || 'null');
    const savedCollapsed = localStorage.getItem('ytbCollapsed') === '1';

    const ytbWrap = document.createElement('div');
    ytbWrap.id = 'ytbWrap';
    ytbWrap.style.cssText = 'position:fixed;width:280px;background:#111;border-radius:10px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.5);z-index:500;';
    if (savedPos) { ytbWrap.style.left = savedPos.left; ytbWrap.style.top = savedPos.top; }
    else { ytbWrap.style.left = '16px'; ytbWrap.style.top = '50%'; ytbWrap.style.transform = 'translateY(-50%)'; }
    document.body.appendChild(ytbWrap);

    const ytbBubble = document.createElement('button');
    ytbBubble.id = 'ytbBubble';
    ytbBubble.style.cssText = 'position:fixed;z-index:500;background:#111;color:#eee;border:none;border-radius:20px;padding:8px 12px;cursor:pointer;box-shadow:0 4px 20px rgba(0,0,0,.5);font-size:12px;display:none;';
    if (savedPos) { ytbBubble.style.left = savedPos.left; ytbBubble.style.top = savedPos.top; }
    else { ytbBubble.style.left = '16px'; ytbBubble.style.top = '50%'; }
    document.body.appendChild(ytbBubble);

    function ytbSavePos(el) {
        localStorage.setItem('ytbPos', JSON.stringify({ left: el.style.left, top: el.style.top }));
    }

    function ytbSetCollapsed(collapsed) {
        localStorage.setItem('ytbCollapsed', collapsed ? '1' : '0');
        ytbWrap.style.display = collapsed ? 'none' : 'block';
        ytbBubble.style.display = collapsed ? 'block' : 'none';
        ytbBubble.style.transform = ytbWrap.style.transform || '';
    }

    // Glisser-déposer (souris + tactile) sur un élément donné, applique la position à ytbWrap et ytbBubble
    function makeDraggable(handle) {
        let dragging = false, offX = 0, offY = 0;
        function start(clientX, clientY) {
            dragging = true;
            const r = ytbWrap.getBoundingClientRect();
            offX = clientX - r.left; offY = clientY - r.top;
        }
        function move(clientX, clientY) {
            if (!dragging) return;
            ytbWrap.style.transform = 'none';
            const maxX = window.innerWidth - ytbWrap.offsetWidth - 4;
            const maxY = window.innerHeight - ytbWrap.offsetHeight - 4;
            const left = Math.max(4, Math.min(maxX, clientX - offX));
            const top = Math.max(4, Math.min(maxY, clientY - offY));
            ytbWrap.style.left = left + 'px';
            ytbWrap.style.top = top + 'px';
        }
        function end() {
            if (!dragging) return;
            dragging = false;
            ytbSavePos(ytbWrap);
        }
        handle.addEventListener('mousedown', (e) => { start(e.clientX, e.clientY); e.preventDefault(); });
        window.addEventListener('mousemove', (e) => move(e.clientX, e.clientY));
        window.addEventListener('mouseup', end);
        handle.addEventListener('touchstart', (e) => { const t = e.touches[0]; start(t.clientX, t.clientY); }, { passive: true });
        window.addEventListener('touchmove', (e) => { const t = e.touches[0]; if (t) move(t.clientX, t.clientY); }, { passive: true });
        window.addEventListener('touchend', end);
    }

    function ytbRenderShell() {
        const t = ytbLang();
        ytbWrap.innerHTML = `
            <div id="ytbHeader" style="display:flex;justify-content:space-between;align-items:center;padding:6px 8px;background:#1a1a1a;cursor:move;">
                <span style="color:#eee;font-size:12px;font-weight:600;">${t.title}</span>
                <div>
                    <button id="ytbSkipBtn" title="${t.skip}" style="background:none;border:none;color:#ccc;cursor:pointer;font-size:14px;margin-right:6px;">⏭️</button>
                    <button id="ytbMinBtn" title="${t.minimize}" style="background:none;border:none;color:#ccc;cursor:pointer;font-size:14px;">➖</button>
                </div>
            </div>
            <div id="ytbPlayerEl" style="width:280px;height:157px;"></div>
            <div id="ytbInstr" style="padding:6px 8px;color:#999;font-size:11px;border-top:1px solid #222;">${t.instr}</div>
            <div id="ytbQueueList" style="padding:4px 8px 8px;font-size:12px;color:#ccc;"></div>
        `;
        ytbWrap.querySelector('#ytbSkipBtn').onclick = () => socket.emit('ytb-skip');
        ytbWrap.querySelector('#ytbMinBtn').onclick = () => ytbSetCollapsed(true);
        makeDraggable(ytbWrap.querySelector('#ytbHeader'));
        ytbBubble.textContent = '▶ ' + t.expand;
    }
    ytbRenderShell();
    makeDraggable(ytbBubble);
    ytbBubble.onclick = (e) => {
        // Évite de ré-ouvrir juste après un drag (clic déclenché en fin de glisser)
        if (ytbBubble._wasDragged) { ytbBubble._wasDragged = false; return; }
        ytbSetCollapsed(false);
    };
    ytbSetCollapsed(savedCollapsed);

    function ytbRenderQueue() {
        const t = ytbLang();
        const listEl = document.getElementById('ytbQueueList');
        if (!listEl) return;
        if (!ytbCurrentQueue.length) { listEl.innerHTML = `<div style="color:#777;">${t.empty}</div>`; return; }
        listEl.innerHTML = ytbCurrentQueue.map((v, i) =>
            i === 0
                ? `<div style="color:#4CAF50;">${t.nowPlaying} — ${v.addedBy}</div>`
                : `<div style="color:#999;">${i + 1}. ${v.addedBy}</div>`
        ).join('');
    }

    window.onYouTubeIframeAPIReady = () => {
        ytbApiReady = true;
        ytbPlayer = new YT.Player('ytbPlayerEl', {
            height: '157', width: '280',
            playerVars: { autoplay: 1, playsinline: 1, origin: window.location.origin },
            events: {
                onReady: () => { ytbPlayerReady = true; if (ytbCurrentQueue.length) ytbLoadCurrent(); },
                onStateChange: (e) => {
                    if (e.data === YT.PlayerState.ENDED && ytbCurrentVideoId) {
                        socket.emit('ytb-ended', { videoId: ytbCurrentVideoId });
                    }
                }
            }
        });
    };

    function ytbLoadCurrent() {
        const first = ytbCurrentQueue[0];
        if (!first) { ytbCurrentVideoId = null; return; }
        if (ytbCurrentVideoId !== first.videoId) {
            ytbCurrentVideoId = first.videoId;
            if (ytbPlayer && ytbPlayer.loadVideoById) ytbPlayer.loadVideoById(first.videoId);
        }
    }

    socket.on('ytb-sync', (data) => {
        ytbCurrentQueue = (data && data.queue) || [];
        ytbRenderQueue();
        if (ytbApiReady && ytbPlayer) ytbLoadCurrent();
    });

    socket.on('ytb-error', (data) => {
        if (data && data.message) showNotification(data.message);
    });

    // Re-render les textes si la langue de la room change
    const _ytbLangObserver = setInterval(() => {
        const lang = localStorage.getItem('roomLang') || 'FR';
        if (ytbWrap.dataset.lang !== lang) {
            ytbWrap.dataset.lang = lang;
            ytbRenderShell();
            ytbRenderQueue();
        }
    }, 1000);
}

// Re-auth as mod on reconnect
socket.on('reconnect', () => {
    // Fermer toutes les connexions WebRTC existantes
    for (const id in peers) {
        try { peers[id].close(); } catch(e) {}
        delete peers[id];
    }
    // Supprimer tous les éléments DOM des peers distants
    document.querySelectorAll('.peer.miniature').forEach(el => el.remove());
    Object.keys(remoteProfiles).forEach(k => delete remoteProfiles[k]);
    featuredUserId = null;
    const featuredEl = document.querySelector('.peer.featured');
    if (featuredEl) featuredEl.classList.add('hidden');

    const modSecret = localStorage.getItem('modSecret');
    if (modSecret) setTimeout(() => socket.emit('mod-auth', { password: modSecret, displayName: myDisplayName }), 500);
    if (roomId) {
        socket.emit('profile-update', { roomId, displayName: myDisplayName, profileColor: myProfileColor, avatarIndex: parseInt(localStorage.getItem('localAvatarIndex') || '0') });
        socket.emit('join-room', roomId);
    }
    if (isModerator) {
        setTimeout(() => socket.emit('mod-badge', { roomId }), 600);
    }
});
