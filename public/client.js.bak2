// ── Chat : largeur réglable par glisser-déposer ─────────────────────────────
(function initChatResize() {
    if (!chatPanel) return;
    const savedWidth = localStorage.getItem('chatPanelWidth');
    if (savedWidth) document.documentElement.style.setProperty('--chat-panel-width', savedWidth);

    const handle = document.createElement('div');
    handle.className = 'resizeHandle';
    chatPanel.style.position = chatPanel.style.position || 'fixed';
    chatPanel.appendChild(handle);

    let dragging = false;
    handle.addEventListener('mousedown', (e) => {
        dragging = true;
        handle.classList.add('dragging');
        document.body.style.userSelect = 'none';
        e.preventDefault();
    });
    window.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        const newWidth = Math.max(260, Math.min(window.innerWidth * 0.9, window.innerWidth - e.clientX));
        document.documentElement.style.setProperty('--chat-panel-width', newWidth + 'px');
    });
    window.addEventListener('mouseup', () => {
        if (!dragging) return;
        dragging = false;
        handle.classList.remove('dragging');
        document.body.style.userSelect = '';
        localStorage.setItem('chatPanelWidth', getComputedStyle(document.documentElement).getPropertyValue('--chat-panel-width').trim());
    });
    // Support tactile (tablette avec souris/pointeur, pas mobile plein écran)
    handle.addEventListener('touchstart', () => { dragging = true; handle.classList.add('dragging'); }, { passive: true });
    window.addEventListener('touchmove', (e) => {
        if (!dragging || !e.touches[0]) return;
        const newWidth = Math.max(260, Math.min(window.innerWidth * 0.9, window.innerWidth - e.touches[0].clientX));
        document.documentElement.style.setProperty('--chat-panel-width', newWidth + 'px');
    }, { passive: true });
    window.addEventListener('touchend', () => {
        if (!dragging) return;
        dragging = false;
        handle.classList.remove('dragging');
        localStorage.setItem('chatPanelWidth', getComputedStyle(document.documentElement).getPropertyValue('--chat-panel-width').trim());
    });
})();

